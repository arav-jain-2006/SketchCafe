{
  "name": "sketch-cafe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/integration/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test \"test/integration/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"browser-tests/*.test.js\"",
    "test:load": "node scripts/load-check.js"
  }
}
